// LogisticBay Timesheets — database schema
//
// Scope rules (see ../../PRODUCT.md and ../../DECISIONS.md):
//   - No jobs, loads, customers, planning, runs, POD or tracking. Ever.
//   - No shared anything with the LogisticBay TMS. This is its own database.
//   - Optional values are nullable (String?), never String @default("").
//   - Times are DateTime. Never strings. (The TMS got this wrong; we don't.)

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

/// Lifecycle of a driver's day. OPEN = draft | active | finishing.
/// CLOSED = submitted | voided. The one-open-shift invariant (see
/// prisma/invariants.sql) keys off exactly this split, so it must be an enum
/// rather than a string — a typo must not silently create a second open shift.
///
/// NOTE: this is the SHIFT lifecycle, not the delivery pipeline. Whether the
/// PDF was emailed lives on ShiftSubmitJob.status and nowhere else.
/// Delivery lifecycle of the outbox row. An enum for the same reason
/// ShiftStatus is: the worker's claim query and retry logic key off these
/// values, and a typo must not strand a submission.
enum SubmitJobStatus {
  pending
  processing
  completed
  failed
}

/// Authorization role carried by a CompanyMembership. Closed at the database
/// boundary so middleware never has to interpret an unknown role string.
enum MembershipRole {
  driver
  admin
}

/// Which kind of ACCOUNT a User is (owner decision, 2026-10-01). Two
/// separate account contexts that share nothing but the database:
///   driver   the phone app. One email = one driver account; it may work for
///            several companies through `driver` memberships.
///   company  the website. Created by company registration; administers a
///            company.
/// The same email may exist ONCE PER KIND. A matching email never relates a
/// driver account to a company account — that would be authority by email.
enum AccountKind {
  driver
  company
}

/// Which kind of client a Session belongs to, fixed for its whole life
/// (owner decision B1, 2026-10-01; D45). It decides how the refresh credential
/// TRAVELS, and the server enforces it:
///   mobile   SecureStore on the phone, presented in a JSON body
///   browser  an HttpOnly cookie, never readable by JavaScript
/// A credential presented through the other transport is refused. It is also
/// what selects the Session's absolute lifetime at creation.
enum SessionClientKind {
  mobile
  browser
}

/// What a one-time AccountToken proves when it is redeemed (B4, B7).
enum AccountTokenPurpose {
  email_verification
  password_reset
}

enum ShiftStatus {
  draft     /// created; checks not yet complete
  active    /// day underway
  finishing /// end-of-shift review, not yet submitted
  submitted /// handed to the outbox — closed
  voided    /// abandoned — closed
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────────

/// A subscribing haulage company. Data controller for its own timesheets (D11).
model Company {
  id           String    @id @default(cuid())
  name         String
  /// Where completed timesheet PDFs are emailed.
  reportEmail  String?
  /// trial | active | past_due | cancelled
  status       String    @default("trial")

  /// THE authority for which local calendar date a shift is filed under (D18).
  /// An IANA identifier — `Europe/London`, `Europe/Vilnius`,
  /// `America/New_York`, `Asia/Dubai`, `Australia/Sydney` — never a numeric
  /// UTC offset, which cannot survive DST and cannot say which zone it is.
  ///
  /// Non-null because a company with no timezone would force shift creation to
  /// fall back on something, and the only candidates are the phone's timezone
  /// (which D18 forbids) or a hard-coded country. `Europe/London` is the V1
  /// default because the first customers are UK hauliers — a default, not an
  /// assumption: no logic may read it as "this product is British".
  ///
  /// Nothing writes this column yet; changing a company's timezone is a future
  /// settings capability, and STATUS.md owns what exists. When it lands, a
  /// change is NOT retrospective — shiftDate is already persisted per shift.
  timezone     String    @default("Europe/London")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships  CompanyMembership[]

  @@index([status])
}

/// Global person identity. A driver is one User no matter how many companies
/// he drives for (D12) — his private diary spans all of them and belongs to him.
model User {
  id           String    @id @default(cuid())

  /// driver (phone) or company (website). NO default: every creation path
  /// states it, and it never changes. Existing accounts were all created by
  /// the phone and were migrated as `driver`.
  accountKind  AccountKind

  /// THE account identity WITHIN ITS KIND (D21, D22 as amended 2026-10-01 —
  /// see the unique key below). Stored canonically as trim + lowercase, and
  /// `citext` so the DATABASE — not a remembered `.toLowerCase()` at one call
  /// site — refuses a second `Driver@Example.com` driver account once
  /// `driver@example.com` exists. Application normalisation alone is not the guarantee (D16): one
  /// forgotten write path would otherwise split a driver's identity in two,
  /// inside the identity system itself.
  ///
  /// Deliberately NOT normalised further: `+`-tags and dots are NOT stripped.
  /// Those forms address genuinely different mailboxes, and merging them
  /// would be a worse bug than the one this fixes.
  email        String    @db.Citext

  /// The canonical name fields (D22). `name` was replaced, not supplemented —
  /// two columns for one concept disagree eventually. Any display or full
  /// name is DERIVED from these two; there is no third column to drift.
  ///
  /// `Shift.driverName` is unaffected: it is a snapshot taken when the shift
  /// started and is never recomputed from a later rename.
  firstName    String
  lastName     String

  passwordHash String

  /// When the account PROVED it owns `email`, by redeeming an
  /// email_verification AccountToken (B4). Null means unproven — not "false",
  /// not "pending": nothing is known. The FIRST verification is kept. Login
  /// does not require it; company creation does.
  emailVerifiedAt DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships   CompanyMembership[]
  sessions      Session[]
  accountTokens AccountToken[]
  pendingCompanyRegistration PendingCompanyRegistration?
  emailMessages EmailMessage[]

  /// One email per KIND (D22 as amended 2026-10-01): a driver and a company
  /// account may share an address; two accounts of one kind may not. The
  /// column is `citext`, so the uniqueness is case-insensitive.
  @@unique([accountKind, email])

  /// Target for the composite foreign keys that carry the account's kind onto
  /// its Sessions and memberships, so the DATABASE can check them against it
  /// (D51) — the Shift ↔ membership pattern of D15.
  @@unique([id, accountKind])
}

/// A company registration that is not finished yet (D51): a COMPANY account
/// has given its company's name, and its email address is not confirmed.
///
/// It is NOT a Company. Holding one creates no Company and no membership; the
/// account administers nothing. Confirming the email will — in one
/// transaction — create the Company and the initial administrator membership
/// and DELETE this row (the approved design: the row holds the name between
/// registration and confirmation, and is removed when the company is
/// created). Replays are stopped by the single-use verification token, and
/// that transaction will delete exactly one row or none.
///
/// Guaranteed by the database (migration 20261002090000):
///   - only a company account owns one: composite foreign key to
///     User(id, accountKind) and CHECK accountKind = 'company';
///   - one per company account: the unique key on (userId, accountKind).
///     The composite foreign key gives each userId exactly one possible
///     accountKind, so that pair is unique exactly when userId is. A rule
///     about one account's unfinished registration, NOT about how many
///     administrators a Company may have;
///   - the name is 1–200 characters with no leading or trailing whitespace.
///     Names are not unique;
///   - the company's timezone is present and has the shape of an IANA place
///     (migration 20261003120000) — no default, no offsets, no Etc/ zones.
/// No expiry and no clean-up job: an unconfirmed registration stays (O1).
/// The administrator's details are the account's own; nothing is copied here.
model PendingCompanyRegistration {
  id          String      @id @default(cuid())
  userId      String
  accountKind AccountKind
  companyName String
  /// The timezone the COMPANY chose at registration (D53): an IANA place,
  /// exactly as chosen (`Asia/Tokyo`, `Europe/Kyiv`) — never an offset, UTC
  /// or an Etc/ zone, and never defaulted. Copied into `Company.timezone`
  /// when the registration is confirmed (a later increment). It belongs to
  /// the company being registered, not to the administrator's account.
  timezone    String
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId, accountKind], references: [id, accountKind], onDelete: Cascade)

  /// THE one-per-account rule — and the unique key over the relation's own
  /// fields that Prisma needs to model it as one-to-one. Deliberately the
  /// only one: a separate unique index on `userId` alone would enforce the
  /// same rule twice (removed in migration 20261002100000).
  @@unique([userId, accountKind])
}

/// A one-time credential sent by email: email verification (24 hours) or
/// password reset (30 minutes) — owner decisions B4, B7.
///
/// The token itself is 32 random bytes that exist only in the email; this row
/// holds its SHA-256 digest. ONE row per user and purpose (the unique key
/// below): issuing a new token REPLACES the old one in place, so a superseded
/// token's digest no longer exists anywhere and cannot be redeemed.
/// Redemption is one conditional write — unconsumed, unexpired, this digest —
/// so a token is used at most once even under concurrency. Lifetimes are
/// enforced by CHECK constraints in the migration, not only by the code that
/// computes them.
model AccountToken {
  id         String              @id @default(cuid())
  userId     String
  purpose    AccountTokenPurpose
  /// SHA-256 of the emailed secret — never the secret.
  tokenHash  String              @unique
  issuedAt   DateTime
  expiresAt  DateTime
  /// Set once, by redemption. Null = not yet used.
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
}

/// One authenticated device/login for a User (AUTH.md). Deliberately has NO
/// companyId: a session SURVIVES company switching, so tenant scope lives in
/// the access token and the membership row, never here. Giving this model a
/// company would create a second authority for "which company is this request
/// for" that the access token could contradict. check-rules already allowlists
/// Session in GLOBAL_MODELS for exactly this reason — do not "fix" it by
/// adding companyId.
///
/// These columns are load-bearing at runtime: the authentication boundary
/// reads this row on EVERY protected request, and refresh rotation conditions
/// its writes on the digest columns below. Do not treat any of them as inert
/// persistence. STATUS.md owns which parts are built.
model Session {
  id        String   @id @default(cuid())
  userId    String

  /// The kind of the account this session authenticates — a copy the
  /// database forces to agree with the User through the composite foreign
  /// key below, so the CHECK `Session_kind_matches_client` can pair it with
  /// `clientKind`: a driver account only ever holds mobile sessions and a
  /// company account only browser sessions (D51).
  accountKind AccountKind

  /// The client this session was created for (SessionClientKind). NO default
  /// on purpose: every creation path must state its kind, so none can inherit
  /// one silently, and it never changes afterwards — a browser session never
  /// becomes a mobile one, nor the reverse.
  clientKind SessionClientKind

  /// THE authoritative lifetime of this authenticated device: ABSOLUTE from
  /// login — 90 days for a mobile session, 7 days for a browser one (B1).
  /// Rotation does not extend it and there is no sliding window or separate
  /// cap — one lifetime, one column.
  expiresAt DateTime

  /// Explicit termination — logout, refresh-token reuse outside the grace
  /// window, or an admin revoke. Null means never revoked. Distinct from
  /// expiresAt by kind: one is a decision, the other is the passage of time.
  /// The row is KEPT on revoke so a revoked session stays distinguishable
  /// from one that never existed.
  revokedAt DateTime?

  /// SHA-256 of the current refresh token — never the token itself. A
  /// deterministic digest, not bcrypt, because refresh must look the session
  /// up BY this value and a per-row salt makes that impossible. Safe here and
  /// not for passwords: the token is 32 random bytes (AUTH.md), so there is no
  /// low-entropy guess space to slow an attacker down in.
  refreshTokenHash String @unique

  /// SHA-256 of the token this one replaced, kept usable for the 60-second
  /// grace window so a driver who loses signal mid-rotation is not logged out.
  /// Null until the first rotation. Nullable rather than defaulting to "" is
  /// load-bearing here, not just hygiene: Postgres treats NULLs as distinct
  /// under a unique index, so every never-rotated session coexists, where ""
  /// would collide across all of them.
  previousRefreshTokenHash String? @unique

  /// The moment the previous hash stops being accepted. Stored as a DEADLINE
  /// rather than derived from a rotation timestamp plus a constant, so
  /// changing the grace period can never retroactively revive a token that
  /// was already dead. NOT a session lifetime — expiresAt is the only one.
  previousRefreshTokenGraceUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId, accountKind], references: [id, accountKind], onDelete: Cascade)

  /// "Log out every device for this user", and any future session list.
  /// Postgres does not index foreign keys automatically.
  @@index([userId])

  // Two invariants Prisma's schema language cannot express live in migration 4
  // as explicit CHECK constraints:
  //   Session_previous_token_paired   — previous hash and grace deadline are
  //     one fact; neither half is readable alone.
  //   Session_previous_token_distinct — a rotation that wrote the same token
  //     into both slots would make the grace window meaningless.
}

/// Joins a driver to a company. Active/inactive lives HERE, not on User —
/// Company A deactivating him must not touch his work for Company B (D12).
model CompanyMembership {
  id         String   @id @default(cuid())
  companyId  String
  userId     String
  /// The member account's kind, forced to agree with the User by the
  /// composite foreign key below, so the CHECK `CompanyMembership_role_matches_kind`
  /// can hold: a driver account's memberships are always `driver`; a company
  /// account's never are (D51). Deliberately NOT "one administrator per
  /// company" — additional company-side users are a later feature.
  accountKind AccountKind
  role       MembershipRole @default(driver)
  active     Boolean  @default(true)
  /// Company's own payroll/employee reference for this driver, if they use one.
  payrollRef String?
  joinedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId, accountKind], references: [id, accountKind], onDelete: Cascade)

  shifts     Shift[]

  @@unique([companyId, userId])
  /// Target for Shift's composite foreign key. Referencing (id, companyId,
  /// userId) as one unit is what makes the database — not application code —
  /// guarantee that a shift's denormalised companyId and userId agree with the
  /// membership that authorised it.
  @@unique([id, companyId, userId])
  @@index([userId, active])
  @@index([companyId, active])
}

// ─────────────────────────────────────────────────────────────────────────────
// The daily record
// ─────────────────────────────────────────────────────────────────────────────

/// One driver's working day for ONE company.
model Shift {
  id           String   @id @default(cuid())

  /// THE authority for this shift: the CompanyMembership that existed and was
  /// active when it was created. Authorization is membership-based (AUTH.md), so
  /// the record has to be too — otherwise deactivation, company switching and
  /// "may submit existing work but start nothing new" have nothing to hang off.
  membershipId String

  /// Denormalised from the membership and constrained to agree with it by the
  /// composite foreign key below. Kept for efficient tenant queries and for
  /// child rows to key against. Never authoritative on their own — the database
  /// will not let them contradict the membership.
  companyId    String
  userId       String

  /// Snapshot of the driver's name as it should print on the PDF.
  driverName   String

  /// The CLIENT's own stable id for ONE logical Start Shift operation.
  ///
  /// The app is offline-first: a shift is started in a yard with no signal,
  /// stored locally, and posted later — possibly more than once, because a
  /// lost response is indistinguishable from a lost request. The client
  /// generates this id once, keeps it with its local shift, and reuses it on
  /// every replay of THAT start. The server can then tell a replay of the same
  /// start from a genuinely new one, which no server-generated id can do.
  ///
  /// It is NOT authority and NOT tenant identity: it never selects a company,
  /// a user or a membership, and it is only ever looked up INSIDE a scope the
  /// verified token already established (see the unique index below).
  ///
  /// Nullable ONLY for Shift rows created before this column existed — a
  /// client id cannot be invented for a start that no client ever identified,
  /// and PostgreSQL treats NULLs as distinct under a unique index, so any
  /// number of them coexist. Every Start Shift creation path requires one; a
  /// null here means "written before offline identity", never "the client
  /// omitted it".
  clientEventId String?

  /// The local calendar date on which this shift STARTED — what the timesheet
  /// is filed under (D18). Derived once, at creation, from startedAt expressed
  /// in the company's IANA timezone (Company.timezone is the authority; the
  /// phone's timezone never is), and immutable in business meaning thereafter:
  /// crossing midnight does not split the shift, re-date it or finish it, and
  /// a later change to the company's timezone does not recompute shifts
  /// already filed. A 22:00 → 06:00 Monday night is one MONDAY timesheet.
  shiftDate   DateTime  @db.Date
  startedAt   DateTime
  endedAt     DateTime?

  status       ShiftStatus @default(draft)
  submittedAt  DateTime?
  /// Set when the driver signs the declaration.
  declaredAt   DateTime?
  notes        String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// One foreign key carrying three guarantees: the membership exists, it
  /// belongs to this user, and it belongs to this company. No onDelete — the
  /// default Restrict is deliberate, so a membership carrying history cannot be
  /// deleted out from under its shifts.
  membership   CompanyMembership @relation(fields: [membershipId, companyId, userId], references: [id, companyId, userId])
  segments     ShiftSegment[]
  submitJobs   ShiftSubmitJob[]

  /// Lets children key on (shiftId, companyId) so the DATABASE — not a code
  /// convention — guarantees a child can never sit under a different company
  /// than its parent shift. Redundant against the primary key by design.
  @@unique([id, companyId])

  /// Idempotent Start Shift, enforced by the database rather than by a
  /// read-then-write the next concurrent call can slip through.
  ///
  /// Scoped to the MEMBERSHIP, which is the narrowest trusted identity a
  /// request already carries (D15): the token names one membership, so the
  /// lookup for a replay is expressible only inside the scope the token
  /// authorised. Deliberately NOT global — two drivers coincidentally
  /// generating the same id must not collide, and a client id must never
  /// become a way to discover that a row exists in another tenant.
  /// Deliberately not keyed on userId either: a driver who works for two
  /// companies (D12) would otherwise have a company-B replay resolve to a
  /// company-A shift and receive it in the response.
  @@unique([membershipId, clientEventId])

  // "At most one OPEN shift per user" cannot be expressed in Prisma — it needs a
  // PARTIAL unique index. The SQL lives in prisma/invariants.sql and must be
  // appended to the first migration by hand. It is NOT applied by `db push`, so
  // until that migration exists the invariant is design intent, not enforcement.
  @@index([companyId, shiftDate])
  @@index([companyId, status])
  @@index([userId, shiftDate])
  @@index([userId, status])
  @@index([membershipId, shiftDate])
}

/// An ASSET-USE segment: which truck + trailer, between which times (PRODUCT.md).
/// NOT a working-time or activity segment. A new segment starts whenever the
/// driver changes truck or trailer, and carries the check done on the new asset.
model ShiftSegment {
  id           String    @id @default(cuid())
  companyId    String
  shiftId      String
  /// 1-based order within the shift.
  sequence     Int

  truckReg     String
  trailerReg   String?

  startedAt    DateTime
  endedAt      DateTime?

  odometerStart Int?
  odometerEnd   Int?

  /// Completed check items: [{ key, label, result: pass|fail|na, note }].
  /// A defect IS a failed item with a note — no photos in V1 (D10).
  truckChecks   Json?
  trailerChecks Json?

  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Composite key: companyId must match the parent shift's. Enforced by the
  /// database, not by remembering to filter. companyId reaches Company through
  /// Shift, so no second relation to Company is needed here.
  shift        Shift    @relation(fields: [shiftId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([shiftId, sequence])
  @@index([companyId, shiftId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Delivery pipeline
// ─────────────────────────────────────────────────────────────────────────────

/// Outbox. Written in the SAME transaction as the submit, then drained by a
/// worker that generates the PDF and emails it, with retries.
///
/// Forked from the TMS, where this pattern was introduced after PDFs went
/// missing on redeploy because submit did the work inline. Do not "simplify"
/// this back into the request handler.
model ShiftSubmitJob {
  id            String    @id @default(cuid())
  companyId     String
  shiftId       String
  status        SubmitJobStatus @default(pending)
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  /// Composite key — see ShiftSegment.
  shift         Shift     @relation(fields: [shiftId, companyId], references: [id, companyId], onDelete: Cascade)

  /// ONE outbox row per shift — the idempotency guarantee (F-09). An offline
  /// client retrying its submission cannot create a second row, so the same
  /// PDF cannot be emailed twice. Retries of a FAILED delivery update this
  /// row (attempts/nextAttemptAt), never insert another.
  @@unique([shiftId])
  @@index([status, nextAttemptAt])
  @@index([companyId, shiftId])
}

/// Which fixed sender an email went from (D55, `MAIL_SENDERS` in
/// api/src/lib/mailer.ts). One concept, one name: these are its keys.
enum EmailSender {
  accounts
  security
  timesheets
}

/// What SES reported about an email it could not deliver, or that its
/// recipient did not want (D56).
///   hard_bounce       a Permanent bounce — the address does not receive mail
///   transient_bounce  a Transient or Undetermined bounce — a full mailbox, a
///                     server that was down; the address is NOT suppressed
///   complaint         the recipient marked the email as spam
enum EmailDeliveryEventKind {
  hard_bounce
  transient_bounce
  complaint
}

/// Why SES will not send to an address (its account-level suppression list,
/// mirrored here, D56). A transient failure is never a reason.
enum EmailSuppressionReason {
  hard_bounce
  complaint
}

/// One email SES accepted for an account (D56): exactly what associates a
/// later bounce or complaint with the ACCOUNT it was sent to — company or
/// driver, never both, never by address. Nothing of the message is stored:
/// no address, no subject, no body. Written only when SES returns a message
/// id; the development outbox writes none.
model EmailMessage {
  id           String      @id @default(cuid())
  /// SES's MessageId for the send — what its notifications name.
  sesMessageId String      @unique
  userId       String
  sender       EmailSender
  sentAt       DateTime    @default(now())

  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  events EmailDeliveryEvent[]

  @@index([userId])
}

/// One bounce or complaint SES reported (D56), processed ONCE: SES's own
/// feedback id is unique, so a redelivered notification records nothing new.
/// No address is stored here — the account comes from the email it concerns,
/// and the address, when it is suppressed, from EmailSuppression.
model EmailDeliveryEvent {
  id             String                 @id @default(cuid())
  /// SES's feedbackId for this bounce or complaint.
  feedbackId     String                 @unique
  kind           EmailDeliveryEventKind
  /// SES's bounce subtype or complaint feedback type, for support — when given.
  detail         String?
  /// The email it concerns, when it was one this application sent and
  /// recorded. Null for anything else (sent before tracking, or not by us).
  emailMessageId String?
  /// When SES says it happened.
  occurredAt     DateTime
  recordedAt     DateTime               @default(now())

  emailMessage EmailMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)

  @@index([emailMessageId])
}

/// An address SES will not deliver to (D56) — the application's copy of SES's
/// account-level suppression list, so it stops asking. Keyed by ADDRESS, as
/// SES's list is: a mailbox that does not exist does not exist for either
/// account kind. A hard bounce and a complaint are separate rows.
model EmailSuppression {
  email      String                 @db.Citext
  reason     EmailSuppressionReason
  /// When SES last reported this reason for this address.
  recordedAt DateTime

  @@id([email, reason])
}

