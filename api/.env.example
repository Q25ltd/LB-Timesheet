# Local Postgres from docker-compose.yml (port 5433 so it never clashes with the TMS)
DATABASE_URL="postgresql://app:app@localhost:5544/lb_timesheet?schema=public"

# Auth — generate your own, and NEVER reuse the TMS's secret
JWT_SECRET="change-me-to-a-long-random-string"

# Comma-separated origins allowed to call this API.
# Leave blank in development to use the localhost defaults (see env.schema.ts).
# REQUIRED in production — the server refuses to start without it, and accepts
# only scheme+host https origins (no "*", no path, no trailing slash).
WEB_ORIGIN=""

# Email delivery (leave blank locally — submissions log instead of send)
SENDGRID_API_KEY=""
MAIL_FROM="timesheets@logisticbay.com"

PORT=3000
NODE_ENV=development
