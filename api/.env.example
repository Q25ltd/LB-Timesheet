# Local Postgres from docker-compose.yml (port 5544 — 5432/5433 were taken on this Mac)
DATABASE_URL="postgresql://app:app@localhost:5544/lb_timesheet?schema=public"

# Auth signing secret. This placeholder is DELIBERATELY REJECTED by validation
# in every environment — the server will not boot with it. Generate a real one
# (and NEVER reuse the TMS's secret):
#     openssl rand -hex 32
# Production requires 64+ characters; development/test require 32+.
JWT_SECRET="REPLACE-ME-run--openssl-rand-hex-32--and-paste-the-result-here"

# Comma-separated origins allowed to call this API.
# Leave blank in development to use the localhost defaults (see env.schema.ts).
# REQUIRED in production — the server refuses to start without it, and accepts
# only scheme+host https origins (no "*", no path, no trailing slash).
WEB_ORIGIN=""

# The ONE web origin that emailed links (email verification, password reset)
# open. Leave blank in development (the Vite dev server is used). REQUIRED in
# production, and must be exactly one of the WEB_ORIGIN entries.
WEB_APP_URL=""

# Email delivery — Amazon SES (D55). How mail leaves this process:
#   outbox    development default: each email is written as a JSON file under
#             api/.mail-outbox/ (gitignored); nothing is sent
#   ses       REAL email through Amazon SES, with the credentials below
#   disabled  every send fails loudly — the test default, and an explicit
#             choice for a production deployment that must send nothing (D57)
# Production refuses to start with this unset, and never accepts outbox.
# Senders are fixed in code (lib/mailer.ts): accounts@, security@ and
# timesheets@logisticbay.com, Reply-To support@logisticbay.com.
MAIL_TRANSPORT=outbox

# Required when MAIL_TRANSPORT=ses: the access key of the IAM user
# `lb-timesheets-ses`, which may only send email as those three addresses.
# Set them in the deployment's secret settings — never commit real values.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Optional: the SNS topic SES publishes bounces and complaints to. When set,
# POST /webhooks/ses accepts SNS-signed messages from this topic only; when
# blank that endpoint does not exist.
SES_NOTIFICATION_TOPIC_ARN=""

# Where a request's client address comes from, for rate limiting (F-15):
#   socket     the TCP peer — trust no header (development default)
#   x-real-ip  Railway's edge-set X-Real-IP header (DEPLOYMENT.md section 5)
# REQUIRED in production. X-Forwarded-For is never read.
CLIENT_IP_SOURCE=socket

PORT=3000
NODE_ENV=development
