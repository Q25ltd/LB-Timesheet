{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "api": {
      "entry": [
        "scripts/*.ts",
        "scripts/rules/*.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "!src/generated/**",
        "scripts/*.ts",
        "scripts/rules/*.ts"
      ],
      "ignoreDependencies": [
        "@prisma/client",
        "@sendgrid/mail",
        "pdfkit",
        "@types/pdfkit",
        "@fastify/jwt",
        "bcryptjs",
        "@types/bcryptjs"
      ]
    }
  }
}
