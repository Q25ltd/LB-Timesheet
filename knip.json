{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "web": {
      "entry": [
        "src/**/*.test.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "mobile": {
      "entry": [
        "app/**/*.tsx",
        "src/**/*.test.ts",
        "src/**/*.test.tsx"
      ],
      "project": [
        "app/**/*.{ts,tsx}",
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "expo-updates"
      ]
    },
    "api": {
      "entry": [
        "scripts/*.ts",
        "scripts/rules/*.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "!src/generated/**",
        "scripts/*.ts",
        "scripts/rules/*.ts"
      ],
      "ignoreDependencies": [
        "@prisma/client",
        "pdfkit",
        "@types/pdfkit",
        "@types/bcryptjs"
      ]
    }
  }
}
